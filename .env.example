# Copy this file to .env and fill in your values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Mac/Linux)
# .env is in .gitignore, so your real keys never get committed.
# Keep this .example file in the repo as a template for others.

# ---- Which AI provider to use ----
# anthropic | openai | gemini | deepseek | grok | github | openrouter | ollama
PROVIDER=anthropic

# ---- API key for your provider (you only need the one you use) ----
# No quotes, no spaces around the =.
ANTHROPIC_API_KEY=your-key-here      # console.anthropic.com
# OPENAI_API_KEY=                    # platform.openai.com
# GEMINI_API_KEY=                    # aistudio.google.com
# DEEPSEEK_API_KEY=                  # platform.deepseek.com
# XAI_API_KEY=                       # console.x.ai (Grok)
# GITHUB_TOKEN=                      # GitHub token with "models: read" (GitHub Models)
# OPENROUTER_API_KEY=                # openrouter.ai
# (ollama needs no key: install Ollama and pull a model)

# ---- Optional ----
# A different model from the same provider. Each provider has a sensible
# default (see PROVIDERS in shared/llm.py); model names change often.
# MODEL=claude-haiku-5-5

# Any other OpenAI-compatible service: set PROVIDER=openai plus this address.
# BASE_URL=https://example.com/v1

# Length limit for non-Claude replies (off by default; see shared/llm.py).
# MAX_TOKENS=4096
