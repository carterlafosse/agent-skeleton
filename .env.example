# Copy this file to .env and fill in your values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Mac/Linux)
# .env is in .gitignore, so your real key never gets committed.
# Keep this .example file in the repo as a template for others.

# Your API key from console.anthropic.com -> API Keys.
# No quotes, no spaces around the =.
ANTHROPIC_API_KEY=your-key-here

# Optional: choose a different model. Remove the # to use it.
# MODEL=claude-haiku-5-5